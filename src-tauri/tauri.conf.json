{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickLaunch",
  "version": "1.1.2",
  "identifier": "com.lyadav.quicklaunch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickLaunch",
        "width": 800,
        "height": 600,
        "backgroundColor": "#6f63c6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNDRFNUZBRDU2Mzk5OEEKUldTS21XUFYrdVZFN3lHMVRBWkF0czRTMmgrOGZRVUdSaUE4NW50QVdJR0ZSQXp3UzRLeTRaSGsK",
      "endpoints": [
        "https://github.com/Lalitmax/quicklaunch/releases/latest/download/latest.json"
      ]
    }
  }
}
